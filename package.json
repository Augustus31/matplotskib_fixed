{
  "name": "matplotskib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Small browser library for bar and line graphs (SVG output).",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target es2022 --module esnext --moduleResolution bundler --skipLibCheck src/index.js",
    "test": "node --test"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
